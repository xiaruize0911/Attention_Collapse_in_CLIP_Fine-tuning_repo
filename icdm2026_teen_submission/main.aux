\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dose-response in the primary controlled experiment. Curves show means over three seeds, shaded regions one standard deviation, and dotted lines the linear-probe reference. On EuroSAT, Full FT crosses from attention broadening to contraction (center), whereas LoRA entropy increases with learning rate; retention nevertheless declines for both methods.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:dose}{{1}{3}{Dose-response in the primary controlled experiment. Curves show means over three seeds, shaded regions one standard deviation, and dotted lines the linear-probe reference. On EuroSAT, Full FT crosses from attention broadening to contraction (center), whereas LoRA entropy increases with learning rate; retention nevertheless declines for both methods}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Primary matched-learning-rate grid: mean $\pm $ across-seed standard deviation over $n$ seeds. $\Delta H$ is the block-averaged entropy change from pretrained CLIP, $\Delta H_{12}$ the last-block change; retention is the surviving percentage of pretrained zero-shot accuracy (61.33\% on CIFAR-100; CIFAR-10 ranks runs almost identically, $\rho =0.971$). Test accuracy is read once, at the validation-selected epoch.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:grid}{{I}{3}{Primary matched-learning-rate grid: mean $\pm $ across-seed standard deviation over $n$ seeds. $\Delta H$ is the block-averaged entropy change from pretrained CLIP, $\Delta H_{12}$ the last-block change; retention is the surviving percentage of pretrained zero-shot accuracy (61.33\% on CIFAR-100; CIFAR-10 ranks runs almost identically, $\rho =0.971$). Test accuracy is read once, at the validation-selected epoch}{table.1}{}}
