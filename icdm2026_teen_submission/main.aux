\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Study~B dose-response; means over three seeds, bands one SD, dotted line the linear-probe reference. Full fine-tuning crosses from attention broadening to contraction (centre) while LoRA's entropy \emph  {rises} with the learning rate, yet retention (right) falls monotonically for both --- so equal forgetting corresponds to opposite-signed entropy changes.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:dose}{{1}{4}{Study~B dose-response; means over three seeds, bands one SD, dotted line the linear-probe reference. Full fine-tuning crosses from attention broadening to contraction (centre) while LoRA's entropy \emph {rises} with the learning rate, yet retention (right) falls monotonically for both --- so equal forgetting corresponds to opposite-signed entropy changes}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Study~B matched-learning-rate grid: mean $\pm $ across-seed SD over $n$ seeds. $\Delta H$ is the block-averaged entropy change from pretrained CLIP, $\Delta H_{12}$ the last-block change; retention is the surviving percentage of pretrained zero-shot accuracy (61.33\% on CIFAR-100; CIFAR-10 tracks it closely, 87.40\% pretrained). Test accuracy is read once, at the validation-selected epoch.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:grid}{{I}{4}{Study~B matched-learning-rate grid: mean $\pm $ across-seed SD over $n$ seeds. $\Delta H$ is the block-averaged entropy change from pretrained CLIP, $\Delta H_{12}$ the last-block change; retention is the surviving percentage of pretrained zero-shot accuracy (61.33\% on CIFAR-100; CIFAR-10 tracks it closely, 87.40\% pretrained). Test accuracy is read once, at the validation-selected epoch}{table.1}{}}
